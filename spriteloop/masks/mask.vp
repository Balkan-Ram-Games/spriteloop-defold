#version 140
in highp vec4 position;
in mediump vec2 texcoord0;
in lowp vec4 color;
out mediump vec2 var_texcoord0;
out lowp vec4 var_color;
out highp float var_selected;
out highp float var_mode;
uniform vs_uniforms {
    highp mat4 view_proj;
    highp vec4 mask_pass;
};
void main() {
    gl_Position = view_proj * vec4(position.xy, 0.0, 1.0);
    var_texcoord0 = texcoord0;
    var_color = color;
    var_selected = abs(position.z - mask_pass.x);
    var_mode = mask_pass.y;
}
