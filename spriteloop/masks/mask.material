name: "spriteloop_mask"
tags: "spriteloop_mask"
vertex_program: "/spriteloop/masks/mask.vp"
fragment_program: "/spriteloop/masks/mask.fp"
vertex_space: VERTEX_SPACE_WORLD
vertex_constants { name: "view_proj" type: CONSTANT_TYPE_VIEWPROJ }
vertex_constants { name: "mask_pass" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
samplers {
  name: "texture_sampler"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
}
samplers {
  name: "coverage_sampler"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
}
