- name: spriteloop
  type: table
  desc: SpriteLoop component playback API.
  members:
  - name: play_anim
    type: function
    desc: Plays an animation on a SpriteLoop component.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    - name: animation_id
      type: string
      desc: Animation id or name to play. Exact ids are matched before names.
    - name: options
      type: table
      desc: Optional table with loop and emit_events booleans. emit_events controls the full playback session and defaults to true.
    returns:
    - name: played
      type: boolean
      desc: True when the animation id or name exists and playback started.
  - name: stop_anim
    type: function
    desc: Stops playback on a SpriteLoop component.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
  - name: set_time
    type: function
    desc: Sets playback time in seconds.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    - name: seconds
      type: number
      desc: Playback time.
    - name: options
      type: table
      desc: Optional table with emit_events. Destination-frame events emit by default.
  - name: set_frame
    type: function
    desc: Sets the current frame index.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    - name: frame_index
      type: number
      desc: Frame index.
    - name: options
      type: table
      desc: Optional table with emit_events. Destination-frame events emit by default.
  - name: consume_events
    type: function
    desc: Returns and clears SpriteLoop animation events collected since the previous call.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    returns:
    - name: events
      type: table
      desc: Array of event tables with event_name, name, data, animation_id, animation_name, frame, and source_frame.
  - name: listen
    type: function
    desc: Registers a Lua callback for a SpriteLoop animation event on one component.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    - name: event_name
      type: string
      desc: Event name to listen for.
    - name: callback
      type: function
      desc: Function called with the event table when dispatch_events consumes a matching event.
    returns:
    - name: listener_id
      type: number
      desc: Numeric listener id that can be passed to unlisten.
  - name: unlisten
    type: function
    desc: Removes SpriteLoop event listeners for one component.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    - name: listener_or_event_name
      type: [number, string]
      desc: Optional listener id or event name. Omit to remove all listeners for the component.
    returns:
    - name: removed
      type: boolean
      desc: True when one or more listener entries existed.
  - name: dispatch_events
    type: function
    desc: Consumes queued events and calls matching Lua listeners registered with listen.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    returns:
    - name: events
      type: table
      desc: Array of consumed event tables.
  - name: set_playback_rate
    type: function
    desc: Sets playback rate multiplier.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    - name: rate
      type: number
      desc: Playback rate multiplier.
  - name: set_visible
    type: function
    desc: Sets SpriteLoop component visibility.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    - name: visible
      type: boolean
      desc: Visibility state.
  - name: set_tint
    type: function
    desc: Sets a whole-character runtime RGB tint multiplier.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    - name: r
      type: number
      desc: Red multiplier clamped to 0..1.
    - name: g
      type: number
      desc: Green multiplier clamped to 0..1.
    - name: b
      type: number
      desc: Blue multiplier clamped to 0..1.
  - name: clear_tint
    type: function
    desc: Resets the whole-character runtime RGB tint multiplier to white.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
  - name: set_skin
    type: function
    desc: Sets the active runtime skin.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    - name: skin_id
      type: string
      desc: Skin id or name. Exact ids are matched before names.
    returns:
    - name: changed
      type: boolean
      desc: True when the skin id or name exists.
  - name: set_variant
    type: function
    desc: Overrides one part variant. Pass "default" to clear the part's manual variant override.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    - name: part_id
      type: string
      desc: Part id, key, or name. Exact ids are matched before keys and names.
    - name: variant_id
      type: string
      desc: Variant id, key, or name for the selected part. Exact ids are matched before keys and names. If a real variant matches "default", it is selected instead of clearing the override.
    returns:
    - name: changed
      type: boolean
      desc: True when the part and variant resolve to a matching pair, or when "default" successfully clears the override.
  - name: clear_variant
    type: function
    desc: Clears one part variant override.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    - name: part_id
      type: string
      desc: Part id, key, or name. Exact ids are matched before keys and names.
    returns:
    - name: changed
      type: boolean
      desc: True when the part id or name exists.
  - name: clear_variants
    type: function
    desc: Clears all part variant overrides.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
  - name: debug_destroy_component
    type: function
    desc: Debug helper that releases one SpriteLoop component runtime instance.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    returns:
    - name: destroyed
      type: boolean
      desc: True when a live component instance was destroyed.
  - name: get_info
    type: function
    desc: Gets debug playback and package information.
    parameters:
    - name: url
      type: [string, hash, url]
      desc: SpriteLoop component URL.
    returns:
    - name: info
      type: table
      desc: Package and playback information, including pending_event_count, max_pending_events, and dropped_event_count.
  - name: get_cache_info
    type: function
    desc: Gets shared package and texture cache diagnostics.
    returns:
    - name: info
      type: table
      desc: Cache entries, reference counts, texture counts, and approximate texture bytes.
