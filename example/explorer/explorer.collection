name: "explorer"
instances {
  id: "controller"
  prototype: "/example/explorer/explorer_controller.go"
}
instances {
  id: "preview"
  prototype: "/example/explorer/explorer_preview.go"
  position { x: 640.0 y: 365.0 }
}
