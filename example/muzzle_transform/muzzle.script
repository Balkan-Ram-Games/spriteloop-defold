local spriteloop = require "spriteloop.spriteloop"
local projectiles = require "example.shared.projectiles"

function init(self)
    self.direction = -1 -- Turret artwork faces left.
    spriteloop.play_anim("#animation", "idle", { loop = true })
    msg.post("#instructions", "instructions", {
        title = "Part Transforms - animated turret muzzle",
        controls = "Space: shoot | A / D: face left / right | Green cross marks the animated muzzle",
        source = "example/muzzle_transform/muzzle.script + example/shared/projectiles.lua",
    })
    msg.post(".", "acquire_input_focus")
end

function update(self, dt)
    local position = projectiles.muzzle("#animation", "gun", vmath.vector3(0, 256, 0))
    if position then
        local screen = projectiles.screen_position(position)
        if screen then msg.post("#instructions", "muzzle_marker", { x = screen.x, y = screen.y }) end
        msg.post("#instructions", "example_status", {
            text = string.format("World muzzle: (%.1f, %.1f) | Facing %s", position.x, position.y,
                self.direction < 0 and "left" or "right"),
        })
    end
    for _, event in ipairs(spriteloop.consume_events("#animation")) do
        if event.name == "shoot" then
            projectiles.fire("#animation", "gun", vmath.vector3(0, 256, 0), self.direction)
        end
    end
end

function final(self)
    msg.post(".", "release_input_focus")
end

function on_input(self, action_id, action)
    if not action.pressed then return end
    if action_id == hash("fire") then
        spriteloop.consume_events("#animation")
        spriteloop.play_anim("#animation", "shoot", { loop = false })
    elseif action_id == hash("left") or action_id == hash("right") then
        self.direction = action_id == hash("left") and -1 or 1
        local scale = go.get_scale()
        scale.x = math.abs(scale.x) * -self.direction
        go.set(".", "scale", scale)
    else return end
    return true
end
