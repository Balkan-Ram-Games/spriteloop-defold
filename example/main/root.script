local PROXIES = {
    basic = "#basic_proxy",
    character = "#character_proxy",
    customization = "#customization_proxy",
    animation_events = "#animation_events_proxy",
    event_listeners = "#event_listeners_proxy",
    muzzle_transform = "#muzzle_transform_proxy",
    pixel_art = "#pixel_art_proxy",
    explorer = "#explorer_proxy",
    lua_api_test = "#lua_api_test_proxy",
}

local SCENE_NAMES = {
    basic = "Basic Playback",
    character = "Character",
    customization = "Skins & Variants",
    animation_events = "Animation Events",
    event_listeners = "Event Listeners",
    muzzle_transform = "Part Transforms",
    pixel_art = "Pixel Art Material",
    explorer = "SPLA Explorer",
    lua_api_test = "API Tests (Dev)",
}

local SCENE_ORDER = {
    "basic",
    "character",
    "customization",
    "animation_events",
    "event_listeners",
    "muzzle_transform",
    "pixel_art",
    "explorer",
    "lua_api_test",
}

local DEBUG_GUI = "#debug_gui"
local function scene_label(scene)
    return SCENE_NAMES[scene] or "none"
end

local function post_debug(self, state)
    msg.post(DEBUG_GUI, "proxy_state", {
        state = state,
        scene = scene_label(self.active_scene or self.loading_scene or self.pending_scene),
        busy = self.busy,
        loads = self.loads,
        unloads = self.unloads,
    })
end

local function load_scene(self, scene)
    msg.post("@render:", "use_stretch_projection", { near = -1, far = 1 })
    self.busy = true
    self.loading_scene = scene
    post_debug(self, "loading")
    msg.post(PROXIES[scene], "load")
end

local function unload_active_scene(self)
    if not self.active_scene then
        return
    end

    self.busy = true
    self.unloading_scene = self.active_scene
    post_debug(self, "unloading")
    msg.post(PROXIES[self.active_scene], "unload")
end

local function switch_scene(self, scene)
    if not PROXIES[scene] then return end
    if self.busy then
        return
    end

    if self.active_scene == scene then
        return
    end

    self.pending_scene = scene
    if self.active_scene then
        unload_active_scene(self)
    else
        local pending = self.pending_scene
        self.pending_scene = nil
        load_scene(self, pending)
    end
end

local function scene_offset(self, offset)
    if self.busy then
        return
    end

    local index = 0
    for i, scene in ipairs(SCENE_ORDER) do
        if scene == self.active_scene then
            index = i
            break
        end
    end
    if index == 0 then
        index = offset > 0 and 0 or 1
    end
    index = ((index - 1 + offset) % #SCENE_ORDER) + 1
    switch_scene(self, SCENE_ORDER[index])
end

local function show_selector(self)
    if self.busy then
        return
    end
    self.pending_scene = nil
    if self.active_scene then
        unload_active_scene(self)
    else
        post_debug(self, "selector")
    end
end

local function toggle_active_scene(self)
    if self.busy then
        return
    end

    if self.active_scene then
        unload_active_scene(self)
    else
        switch_scene(self, "basic")
    end
end

function init(self)
    self.active_scene = nil
    self.loading_scene = nil
    self.unloading_scene = nil
    self.pending_scene = nil
    self.busy = false
    self.loads = 0
    self.unloads = 0
    msg.post(".", "acquire_input_focus")
    post_debug(self, "starting")
    post_debug(self, "selector")
end

function on_message(self, message_id, _message, sender)
    if message_id == hash("proxy_loaded") then
        self.active_scene = self.loading_scene
        self.loading_scene = nil
        self.busy = false
        self.loads = self.loads + 1
        msg.post(sender, "enable")
        post_debug(self, "loaded")
        print("Loaded " .. scene_label(self.active_scene) .. " collection proxy")
    elseif message_id == hash("proxy_unloaded") then
        self.active_scene = nil
        self.unloading_scene = nil
        self.busy = false
        self.unloads = self.unloads + 1
        post_debug(self, "unloaded")
        print("Unloaded collection proxy")

        if self.pending_scene then
            local pending = self.pending_scene
            self.pending_scene = nil
            load_scene(self, pending)
        end
    elseif message_id == hash("proxy_load_error") then
        self.active_scene = nil
        self.loading_scene = nil
        self.unloading_scene = nil
        self.pending_scene = nil
        self.busy = false
        post_debug(self, "load error")
        print("Failed to load collection proxy")
    elseif message_id == hash("ui_toggle_scene") then
        toggle_active_scene(self)
    elseif message_id == hash("ui_select_scene") then
        switch_scene(self, _message.scene)
    elseif message_id == hash("ui_show_selector") then
        show_selector(self)
    elseif message_id == hash("ui_next_scene") then
        scene_offset(self, 1)
    elseif message_id == hash("ui_previous_scene") then
        scene_offset(self, -1)
    end
end
