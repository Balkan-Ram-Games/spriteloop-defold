local spriteloop = require "spriteloop.spriteloop"
local spla = require "spriteloop.spla"

local COMPONENT = "#robot"
local EVENT_COMPONENT = "#event_robot"
local RESULTS_GUI = "#results"

local tests_run = 0
local tests_passed = 0

local function expect(label, actual, expected)
    tests_run = tests_run + 1
    if actual ~= expected then
        msg.post(RESULTS_GUI, "test_progress", {
            done = true,
            failed = tests_run - tests_passed,
            label = label,
            passed = tests_passed,
            total = tests_run,
        })
        error(string.format("SpriteLoop Lua API test failed: %s expected %s got %s",
            label, tostring(expected), tostring(actual)))
    end
    tests_passed = tests_passed + 1
    msg.post(RESULTS_GUI, "test_progress", {
        failed = 0,
        label = label,
        passed = tests_passed,
        total = tests_run,
    })
    print(string.format("SpriteLoop Lua API test ok: %s -> %s", label, tostring(actual)))
end

local function expect_near(label, actual, expected)
    expect(label, math.abs(actual - expected) < 0.001, true)
end

function init(self)
    tests_run = 0
    tests_passed = 0
    expect("native extension version", spla.version(), "0.13.0-alpha")
    local info = spriteloop.get_info(COMPONENT)
    expect("get_info has skins", (info.skin_count or 0) > 0, true)
    expect("get_info has variants", (info.variant_count or 0) > 0, true)
    local default_skin_index = -1
    for index, skin in ipairs(info.skins or {}) do
        if skin.id == "default" then
            default_skin_index = index - 1
            break
        end
    end
    expect("blank component skin selects package default", info.skin_index, default_skin_index)
    expect("get_info event queue limit", info.max_pending_events, 256)
    expect("get_info pending events", info.pending_event_count, 0)
    expect("get_info dropped events", info.dropped_event_count, 0)
    expect("get_info default tint red", info.tint_r, 1)
    expect("get_info default tint green", info.tint_g, 1)
    expect("get_info default tint blue", info.tint_b, 1)

    spriteloop.set_tint(COMPONENT, 1, 0.5, 0.25)
    info = spriteloop.get_info(COMPONENT)
    expect("set_tint red", info.tint_r, 1)
    expect("set_tint green", info.tint_g, 0.5)
    expect("set_tint blue", info.tint_b, 0.25)
    spriteloop.set_tint(COMPONENT, 1, 0.5, 0.25)
    info = spriteloop.get_info(COMPONENT)
    expect("set_tint repeated red", info.tint_r, 1)
    expect("set_tint repeated green", info.tint_g, 0.5)
    expect("set_tint repeated blue", info.tint_b, 0.25)
    spriteloop.set_tint(COMPONENT, 2, -1, 0.75)
    info = spriteloop.get_info(COMPONENT)
    expect("set_tint clamps red", info.tint_r, 1)
    expect("set_tint clamps green", info.tint_g, 0)
    expect("set_tint clamps blue", info.tint_b, 0.75)
    spriteloop.clear_tint(COMPONENT)
    info = spriteloop.get_info(COMPONENT)
    expect("clear_tint red", info.tint_r, 1)
    expect("clear_tint green", info.tint_g, 1)
    expect("clear_tint blue", info.tint_b, 1)

    expect("play animation by id", spriteloop.play_anim(COMPONENT, "idle"), true)
    expect("play animation by name", spriteloop.play_anim(COMPONENT, "Idle"), true)
    expect("play animation with events disabled",
        spriteloop.play_anim(COMPONENT, "idle", { emit_events = false }), true)
    expect("missing animation", spriteloop.play_anim(COMPONENT, "__missing_animation__"), false)

    spriteloop.set_frame(COMPONENT, 0, { emit_events = false })
    local body_transform = spriteloop.get_part_transform(COMPONENT, "body_top")
    expect("part transform by name", body_transform ~= nil, true)
    expect_near("part pivot x uses centered Defold coordinates", body_transform.position.x, 59)
    expect_near("part pivot y uses centered Defold coordinates", body_transform.position.y, 117.833)
    expect_near("part rotation uses Defold direction", body_transform.rotation, 0)
    expect_near("part signed scale x", body_transform.scale.x, 1)
    expect_near("part signed scale y", body_transform.scale.y, 1)
    expect_near("part skew x", body_transform.skew.x, 0)
    expect_near("part skew y", body_transform.skew.y, 0)
    expect_near("part opacity", body_transform.opacity, 1)
    local body_by_id = spriteloop.get_part_transform(COMPONENT, "4_group_38_4", {
        origin = "pivot",
    })
    expect_near("part transform by id", body_by_id.position.y, body_transform.position.y)
    local body_center = spriteloop.get_part_transform(COMPONENT, "body_top", {
        origin = "center",
    })
    expect_near("center equals centered body pivot x", body_center.position.x, body_transform.position.x)
    expect_near("center equals centered body pivot y", body_center.position.y, body_transform.position.y)

    local arm_pivot = spriteloop.get_part_transform(COMPONENT, "arm_back")
    local arm_center = spriteloop.get_part_transform(COMPONENT, "arm_back", {
        origin = "center",
    })
    expect("off-center image center differs from pivot",
        math.abs(arm_center.position.x - arm_pivot.position.x) > 0.001, true)
    expect_near("off-center image center x", arm_center.position.x, -115.323)
    expect_near("off-center image center y", arm_center.position.y, 4.528)

    spriteloop.set_frame(COMPONENT, 1, { emit_events = false })
    local moved_body = spriteloop.get_part_transform(COMPONENT, "body_top")
    expect_near("part transform follows current frame", moved_body.position.y, 116.606362)
    expect("missing part transform returns nil",
        spriteloop.get_part_transform(COMPONENT, "__missing_part__"), nil)
    expect("part transform rejects non-table options",
        pcall(spriteloop.get_part_transform, COMPONENT, "body_top", "center"), false)
    expect("part transform rejects unknown origin",
        pcall(spriteloop.get_part_transform, COMPONENT, "body_top", { origin = "visual" }), false)

    expect("set skin by id/name", spriteloop.set_skin(COMPONENT, "blue_robot"), true)
    expect("missing skin", spriteloop.set_skin(COMPONENT, "__missing_skin__"), false)

    expect("set variant by part and variant names",
        spriteloop.set_variant(COMPONENT, "body_top", "torso_blue"), true)
    expect("reset variant with lowercase default",
        spriteloop.set_variant(COMPONENT, "body_top", "default"), true)
    expect("set variant before display-case reset",
        spriteloop.set_variant(COMPONENT, "body_top", "torso_blue"), true)
    expect("reset variant with display-case Default",
        spriteloop.set_variant(COMPONENT, "body_top", "Default"), true)
    expect("reset variant by internal part id",
        spriteloop.set_variant(COMPONENT, "4_group_38_4", "default"), true)
    expect("default does not hide a missing part",
        spriteloop.set_variant(COMPONENT, "__missing_part__", "default"), false)
    expect("missing variant part",
        spriteloop.set_variant(COMPONENT, "__missing_part__", "torso_blue"), false)
    expect("missing variant for part",
        spriteloop.set_variant(COMPONENT, "body_top", "__missing_variant__"), false)
    expect("clear variant by part name", spriteloop.clear_variant(COMPONENT, "body_top"), true)
    expect("clear missing variant part", spriteloop.clear_variant(COMPONENT, "__missing_part__"), false)

    spriteloop.clear_variants(COMPONENT)

    expect("event animation with events disabled",
        spriteloop.play_anim(EVENT_COMPONENT, "run", { emit_events = false }), true)
    expect("disabled play emits no frame 0 event",
        #spriteloop.consume_events(EVENT_COMPONENT), 0)

    spriteloop.set_frame(EVENT_COMPONENT, 0)
    local events = spriteloop.consume_events(EVENT_COMPONENT)
    expect("set_frame emits destination event count", #events, 1)
    expect("set_frame emits destination event", events[1].name, "step")
    expect("set_frame event frame", events[1].frame, 0)

    spriteloop.set_frame(EVENT_COMPONENT, 1, { emit_events = false })
    expect("set_frame emit_events false suppresses destination event",
        #spriteloop.consume_events(EVENT_COMPONENT), 0)

    spriteloop.set_time(EVENT_COMPONENT, 0)
    events = spriteloop.consume_events(EVENT_COMPONENT)
    expect("set_time emits destination event count", #events, 1)
    expect("set_time emits destination event", events[1].name, "step")
    expect("set_time event frame", events[1].frame, 0)

    spriteloop.set_time(EVENT_COMPONENT, 1 / 60, { emit_events = false })
    expect("set_time emit_events false suppresses destination event",
        #spriteloop.consume_events(EVENT_COMPONENT), 0)

    expect("event animation queues frame 0",
        spriteloop.play_anim(EVENT_COMPONENT, "run"), true)
    spriteloop.set_frame(EVENT_COMPONENT, 1, { emit_events = false })
    events = spriteloop.consume_events(EVENT_COMPONENT)
    expect("seek preserves already queued events", #events, 1)
    expect("preserved event name", events[1].name, "step")
    expect("preserved event frame", events[1].frame, 0)
    spriteloop.stop_anim(EVENT_COMPONENT)
    spriteloop.consume_events(EVENT_COMPONENT)

    local variant_handle = spla.load("/example/assets/robot_idle_skins.spla")
    expect("low-level play for part transform", spla.play(variant_handle, "idle"), true)
    spla.set_frame(variant_handle, 0, { emit_events = false })
    local low_level_transform = spla.get_part_transform(variant_handle, "body_top")
    expect("low-level part transform", low_level_transform ~= nil, true)
    expect_near("low-level part transform x", low_level_transform.position.x, 59)
    expect_near("low-level part transform y", low_level_transform.position.y, 117.833)
    expect("low-level set variant",
        spla.set_variant(variant_handle, "body_top", "torso_blue"), true)
    expect("low-level reset variant with default",
        spla.set_variant(variant_handle, "body_top", "default"), true)
    expect("low-level reset variant with Default",
        spla.set_variant(variant_handle, "body_top", "Default"), true)
    spla.destroy(variant_handle)

    local keyed_handle = spla.load("/example/assets/ranger_idle.spla")
    expect("low-level play for keyed part transform", spla.play(keyed_handle, "idle"), true)
    spla.set_frame(keyed_handle, 0, { emit_events = false })
    local keyed_transform = spla.get_part_transform(keyed_handle, "right_hand")
    expect("part transform by runtime key", keyed_transform ~= nil, true)
    expect_near("part rotation sign conversion", keyed_transform.rotation, -349.807)
    local empty_pivot = spla.get_part_transform(keyed_handle, "empty")
    local empty_center = spla.get_part_transform(keyed_handle, "empty", { origin = "center" })
    expect("Empty Part transform by runtime key", empty_pivot ~= nil, true)
    expect_near("Empty Part pivot x", empty_pivot.position.x, 109.053)
    expect_near("Empty Part pivot y", empty_pivot.position.y, 24.751)
    expect_near("Empty Part center equals pivot x", empty_center.position.x, empty_pivot.position.x)
    expect_near("Empty Part center equals pivot y", empty_center.position.y, empty_pivot.position.y)
    spla.set_frame(keyed_handle, 1, { emit_events = false })
    local skewed_transform = spla.get_part_transform(keyed_handle, "arrow")
    expect_near("part scale x", skewed_transform.scale.x, 0.976091)
    expect_near("part scale y", skewed_transform.scale.y, 0.976091)
    expect_near("part skew sign conversion", skewed_transform.skew.x, 2.691364)
    spla.destroy(keyed_handle)

    local handle = spla.load("/example/events/clockheart.spla")
    local handle_info = spla.get_info(handle)
    expect("low-level event queue limit", handle_info.max_pending_events, 256)
    expect("low-level default tint red", handle_info.tint_r, 1)
    expect("low-level default tint green", handle_info.tint_g, 1)
    expect("low-level default tint blue", handle_info.tint_b, 1)
    spla.set_tint(handle, 1, 0.5, 0.25)
    handle_info = spla.get_info(handle)
    expect("low-level set_tint red", handle_info.tint_r, 1)
    expect("low-level set_tint green", handle_info.tint_g, 0.5)
    expect("low-level set_tint blue", handle_info.tint_b, 0.25)
    spla.set_tint(handle, 2, -1, 0.75)
    handle_info = spla.get_info(handle)
    expect("low-level set_tint clamps red", handle_info.tint_r, 1)
    expect("low-level set_tint clamps green", handle_info.tint_g, 0)
    expect("low-level set_tint clamps blue", handle_info.tint_b, 0.75)
    spla.clear_tint(handle)
    handle_info = spla.get_info(handle)
    expect("low-level clear_tint red", handle_info.tint_r, 1)
    expect("low-level clear_tint green", handle_info.tint_g, 1)
    expect("low-level clear_tint blue", handle_info.tint_b, 1)
    expect("low-level play with events disabled",
        spla.play(handle, "run", { emit_events = false }), true)
    spla.set_frame(handle, 0, { emit_events = false })
    spla.set_time(handle, 0, { emit_events = false })
    expect("low-level suppressed events", #spla.consume_events(handle), 0)
    spla.destroy(handle)

    msg.post(RESULTS_GUI, "test_progress", {
        done = true,
        failed = 0,
        label = "All Lua API tests passed",
        passed = tests_passed,
        total = tests_run,
    })
    print("SpriteLoop Lua API test passed")
end
